  "license": "ISC",
  "engines": {
    "node": ">=24",
    "npm": ">=11.10.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@vite-pwa/assets-generator": "^1.0.4",
    "jsdom": "^30.1.1",
    "opentype.js": "^2.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild": true
  }

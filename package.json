{
  "name": "mnemo-jewels",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test-watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "icons:generate": "node assets/icons/generate-icons.mjs",
    "data:russian": "node --experimental-strip-types tools/russian/generate.ts",
    "data:russian:sanitize": "node --experimental-strip-types tools/russian/generate.ts --sanitize",
    "data:russian:download": "node --experimental-strip-types tools/russian/generate.ts --download",
    "data:romance": "node --experimental-strip-types tools/romance/generate.ts",
    "data:romance:download": "node --experimental-strip-types tools/romance/generate.ts --download",
    "data:portuguese": "node --experimental-strip-types tools/romance/generate.ts --language pt",
    "data:portuguese:reverse": "node --experimental-strip-types tools/romance/generate.ts --language pt --reverse",
    "data:portuguese:download": "node --experimental-strip-types tools/romance/generate.ts --language pt --reverse --download",
    "data:jev": "node --experimental-strip-types tools/jev/cli.ts",
    "data:jev:analyze": "node --experimental-strip-types tools/jev/analyze.ts",
    "data:jev:policy": "node --experimental-strip-types tools/jev/policy.ts",
    "data:jev:compare": "node --experimental-strip-types tools/jev/compare.ts",
    "data:jev:apply": "node --experimental-strip-types tools/jev/apply.ts"
